# Copia este archivo como .env y completa los valores. Ninguno es secreto:
# todo lo que empieza por VITE_ termina en el JS público.

# URL pública del sitio, sin barra final (canonical, Open Graph, sitemap).
# En Vercel/Netlify se detecta sola si la dejas vacía.
SITE_URL=

# Endpoint del formulario. Formspree: https://formspree.io/f/xxxxxxx
# Cualquier endpoint que acepte POST JSON y responda 2xx sirve.
VITE_FORM_ENDPOINT=

# Analítica opcional (deja vacío para desactivar).
# Plausible: el dominio registrado, p. ej. midominio.com
VITE_PLAUSIBLE_DOMAIN=
# Google Analytics 4: G-XXXXXXXXXX
VITE_GA_ID=
